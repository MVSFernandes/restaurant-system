# Escolhe as imagens e o destino de uma instalação.
# Copie para a pasta privada da instalação, fora do repositório.
# Este arquivo não guarda segredos: eles ficam nos arquivos indicados abaixo.
# Roteiro: RELEASES.md.
#
# Variáveis RS_* definidas no shell VENCEM este arquivo. Não defina
# COMPOSE_PROJECT_NAME aqui: ele troca o projeto. A conferência da seção 3.1 pega
# os dois casos.

# Mesmo valor de INSTALLATION_ID. Também é o nome do projeto no Compose.
RS_INSTALLATION_ID=

# Imagens da release. Nunca :latest. Com um registro, use imagem@sha256:...
RS_BACKEND_IMAGE=restaurant-backend:vX.Y.Z
RS_FRONTEND_IMAGE=restaurant-frontend:vX.Y.Z

# Caminhos absolutos, com barras normais, inclusive no Windows.
# Backend: modelo em backend/.env.example.
# Frontend: modelo em frontend/.env.docker.example.
RS_BACKEND_ENV_FILE=C:/caminho/privado/backend.env
RS_FRONTEND_ENV_FILE=C:/caminho/privado/frontend.env

# Endereço publicado na máquina. FRONTEND_URL do backend precisa corresponder.
RS_HTTP_PUBLISH=127.0.0.1:18080
