# Variáveis do backend para o Docker Compose.
# Copie para backend/.env.docker. Esses valores são só de teste. O backend só
# sobe depois de conferir a identidade da instalação no banco (tabela
# app_installation); com estes valores isso só acontece no CI, onde
# docker-compose.ci.yml troca o banco por um stub local de teste. Para usar o
# sistema de verdade, coloque as chaves reais do Supabase e da Focus NFe e a
# identidade da instalação no .env.docker (que não vai pro Git).

# Identidade da instalação: igual ao marcador gravado no banco.
INSTALLATION_ID=ci-smoke
# development, test, staging ou production.
APP_ENV=test

PORT=3001
FRONTEND_URL=http://localhost:8080

SUPABASE_URL=https://exemplo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=chave-de-teste

JWT_SECRET=segredo-de-teste
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=outro-segredo-de-teste
JWT_REFRESH_EXPIRES_IN=7d

FOCUS_NFE_TOKEN=token-de-teste
FOCUS_NFE_ENVIRONMENT=homologation
FOCUS_NFE_WEBHOOK_SECRET=webhook-de-teste

RESTAURANT_TIMEZONE=America/Sao_Paulo
