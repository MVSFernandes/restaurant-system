# Variáveis do backend para o Docker Compose.
# Copie para backend/.env.docker. Esses valores são só de teste: a rota /health
# funciona com eles, mas para usar o sistema de verdade coloque as chaves reais
# do Supabase e da Focus NFe no .env.docker (que não vai pro Git).

PORT=3001
FRONTEND_URL=http://localhost:8080

SUPABASE_URL=https://exemplo.supabase.co
SUPABASE_SERVICE_ROLE_KEY=chave-de-teste

JWT_SECRET=segredo-de-teste
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=outro-segredo-de-teste
JWT_REFRESH_EXPIRES_IN=7d

FOCUS_NFE_TOKEN=token-de-teste
FOCUS_NFE_ENVIRONMENT=homologation
FOCUS_NFE_WEBHOOK_SECRET=webhook-de-teste

RESTAURANT_TIMEZONE=America/Sao_Paulo
