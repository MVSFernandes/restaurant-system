# Obrigatórias: sem qualquer uma delas o servidor não sobe (src/config/env.ts).
# JWT_SECRET, JWT_REFRESH_SECRET, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# FOCUS_NFE_TOKEN, FOCUS_NFE_ENVIRONMENT, FOCUS_NFE_WEBHOOK_SECRET, FRONTEND_URL

PORT=3001
# Origens aceitas pelo CORS, separadas por vírgula.
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

JWT_SECRET=replace-with-a-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-secret
JWT_REFRESH_EXPIRES_IN=7d

FOCUS_NFE_TOKEN=your-focus-nfe-token
# Exatamente production ou homologation; qualquer outro valor impede a partida.
FOCUS_NFE_ENVIRONMENT=homologation
# O mesmo valor do campo authorization do gatilho cadastrado na Focus NFe.
FOCUS_NFE_WEBHOOK_SECRET=replace-with-a-webhook-secret

# Fuso IANA do restaurante; define o início e o fim do dia em relatórios, fechamentos e cardápio diário.
RESTAURANT_TIMEZONE=America/Sao_Paulo
