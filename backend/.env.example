# Obrigatórias: sem qualquer uma delas o servidor não sobe (src/config/env.ts).
# JWT_SECRET, JWT_REFRESH_SECRET, SUPABASE_URL, SUPABASE_SERVICE_ROLE_KEY,
# FRONTEND_URL, INSTALLATION_ID, APP_ENV e, com a emissão fiscal ativa,
# FOCUS_NFE_TOKEN, FOCUS_NFE_ENVIRONMENT, FOCUS_NFE_WEBHOOK_SECRET.

# Identidade da instalação. Antes de aceitar requisições, o servidor confere se
# estes dois valores são iguais ao marcador gravado no banco (tabela
# app_installation). O servidor não cria o marcador: ele é gravado no banco, uma
# vez, no passo de configuração da instalação.
# INSTALLATION_ID: 3 a 64 caracteres, letras minúsculas, números e hífens.
INSTALLATION_ID=nome-da-instalacao-dev
# development, test, staging ou production. Fora de production, a emissão
# fiscal de produção é recusada (FOCUS_NFE_ENVIRONMENT=production ou a URL de
# produção da Focus).
APP_ENV=development

PORT=3001
# Origens aceitas pelo CORS, separadas por vírgula.
FRONTEND_URL=http://localhost:5173

SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

JWT_SECRET=replace-with-a-secret
JWT_EXPIRES_IN=15m
JWT_REFRESH_SECRET=replace-with-another-secret
JWT_REFRESH_EXPIRES_IN=7d

# Emissão fiscal ativa (padrão). Com false, as três variáveis FOCUS_NFE_*
# abaixo deixam de ser exigidas e nenhuma nota pode ser emitida.
FOCUS_NFE_ENABLED=true
FOCUS_NFE_TOKEN=your-focus-nfe-token
# Exatamente production ou homologation; qualquer outro valor impede a partida.
FOCUS_NFE_ENVIRONMENT=homologation
# O mesmo valor do campo authorization do gatilho cadastrado na Focus NFe.
FOCUS_NFE_WEBHOOK_SECRET=replace-with-a-webhook-secret

# Fuso IANA do restaurante; define o início e o fim do dia em relatórios, fechamentos e cardápio diário.
RESTAURANT_TIMEZONE=America/Sao_Paulo

# Só para npm run supabase:types: referência (20 letras) do projeto Supabase de
# DESENVOLVIMENTO. Não é usada pelo servidor.
SUPABASE_PROJECT_ID=
