# Configuração pública do frontend no Docker Compose.
# Copie para frontend/.env.docker (fora do Git) e preencha.
# Tudo aqui fica público: qualquer visitante pode ler em /runtime-config.json.
# Nunca coloque aqui a service_role, chaves secretas ou segredos JWT.
# Sem valores válidos, o container não sobe. Veja frontend/RUNTIME_CONFIG.md.

# /api usa o Nginx deste container, que repassa para o backend.
PUBLIC_API_URL=/api

# URL do mesmo projeto Supabase do backend desta instalação.
PUBLIC_SUPABASE_URL=

# Chave pública do mesmo projeto: anon ou sb_publishable_.
PUBLIC_SUPABASE_ANON_KEY=
