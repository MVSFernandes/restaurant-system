# Local development only (`npm run dev`). Builds and images ignore these values:
# an installation is configured when it starts. See RUNTIME_CONFIG.md.
# All three are required: without them the app shows a configuration error.
VITE_API_URL=http://localhost:3001/api

# Public credentials, used only for Supabase Realtime channels.
# Never put the backend service role key here.
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your-supabase-anon-key
